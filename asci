
#include <iostream>
using namespace std;

int main()
{
    // Part 1: Terminating a loop with 'q'
    char character;
    int counter = 0;

    cout << "Enter a character (q to quit): ";
    cin >> character;

    while (character != 'q')
    {
        counter++;

        cout << "Enter a character (q to quit): ";
        cin >> character;
    }

    cout << "Counter value: " << counter << endl;
    cout << "Final character: " << character << endl;

    // Part 2: Printing ASCII characters
    cout << "\nLowercase alphabet:" << endl;

    for (int i = 97; i <= 122; i++)
    {
        char letter = i;
        cout << letter << " ";
    }

    cout << endl;

    return 0;
}
